{
  "skill_id": "de_media_06_sk04",
  "name": "报告排版",
  "type": "atomic",
  "input": {
    "type": "object",
    "required": [
      "metrics"
    ],
    "properties": {
      "metrics": {
        "type": "string",
        "description": "数据：需要汇总的指标数据"
      },
      "period": {
        "type": "string",
        "description": "周期：报告覆盖的时间范围（可选）"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "headline",
      "metrics_summary",
      "drivers",
      "suggestion"
    ],
    "properties": {
      "headline": {
        "type": "string",
        "description": "一句话结论，先行给出"
      },
      "metrics_summary": {
        "type": "array",
        "description": "本期/上期/变化",
        "items": {
          "type": "object",
          "properties": {
            "指标": {
              "type": "string"
            },
            "本期": {
              "type": "string"
            },
            "上期": {
              "type": "string"
            },
            "变化": {
              "type": "string"
            },
            "说明": {
              "type": "string"
            }
          }
        }
      },
      "drivers": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "影响结果的主要原因"
      },
      "suggestion": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "下一步可执行的动作"
      }
    },
    "x-rendered-from": "capability:report"
  },
  "constraints": {
    "max_input_length": 5000,
    "forbidden_words": [
      "最好",
      "第一",
      "100%"
    ],
    "ai_label_required": true,
    "human_review_required": true,
    "external_api_required": false
  }
}