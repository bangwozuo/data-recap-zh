{
  "skill_id": "de_media_06_sk03",
  "name": "策略建议生成",
  "type": "atomic",
  "input": {
    "type": "object",
    "required": [
      "goal"
    ],
    "properties": {
      "goal": {
        "type": "string",
        "description": "目标：要达成什么"
      },
      "resources": {
        "type": "string",
        "description": "资源约束：预算、人力、周期等限制（可选）"
      },
      "audience": {
        "type": "string",
        "description": "执行对象：方案作用于谁（可选）"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "steps",
      "scripts",
      "risks"
    ],
    "properties": {
      "steps": {
        "type": "array",
        "description": "可执行的步骤",
        "items": {
          "type": "object",
          "properties": {
            "阶段": {
              "type": "string"
            },
            "动作": {
              "type": "string"
            },
            "负责人": {
              "type": "string"
            },
            "产出物": {
              "type": "string"
            },
            "时间点": {
              "type": "string"
            }
          }
        }
      },
      "scripts": {
        "type": "string",
        "description": "执行时可直接使用的话术或模板"
      },
      "risks": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "可能出问题的地方与应对"
      }
    },
    "x-rendered-from": "capability:generate_sop"
  },
  "constraints": {
    "max_input_length": 5000,
    "forbidden_words": [
      "最好",
      "第一",
      "100%"
    ],
    "ai_label_required": true,
    "human_review_required": true,
    "external_api_required": false
  }
}